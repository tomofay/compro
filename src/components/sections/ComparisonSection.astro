---
import { getDictionary, getLocalizedPath, type Locale } from '@/i18n';
import { ArrowRight, Check, X } from 'lucide-react';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const c = dict.comparisonSection;
---

<section class="border-t border-slate-200 bg-slate-50 py-16">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-xs font-semibold tracking-wider text-emerald-700 uppercase">
        {c.eyebrow}
      </p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        {c.title}
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-slate-600 sm:text-base">
        {c.subtitle}
      </p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-6 lg:grid-cols-2">
      <div class="rounded-md border border-slate-200 bg-white p-6">
        <div class="flex items-center justify-between border-b border-slate-100 pb-4">
          <h3 class="text-base font-semibold text-slate-900">
            {c.leftHeader}
          </h3>
          <span class="rounded-sm border border-slate-200 bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-600">
            {c.leftTag}
          </span>
        </div>
        <ul class="mt-5 space-y-3.5">
          {
            c.leftItems.map((item) => (
              <li class="flex items-start gap-3 text-sm text-slate-600">
                <div class="mt-0.5 shrink-0 rounded-sm border border-slate-200 bg-slate-50 p-1 text-slate-400">
                  <X className="h-3.5 w-3.5" aria-hidden="true" />
                </div>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="flex flex-col justify-between rounded-md border border-emerald-300 bg-white p-6">
        <div>
          <div class="flex items-center justify-between border-b border-emerald-100 pb-4">
            <h3 class="text-base font-bold text-slate-900">
              {c.rightHeader}
            </h3>
            <span class="rounded-sm border border-emerald-200 bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-700">
              {c.rightTag}
            </span>
          </div>
          <ul class="mt-5 space-y-3.5">
            {
              c.rightItems.map((item) => (
                <li class="flex items-start gap-3 text-sm font-medium text-slate-800">
                  <div class="mt-0.5 shrink-0 rounded-sm border border-emerald-200 bg-emerald-50 p-1 text-emerald-700">
                    <Check className="h-3.5 w-3.5" aria-hidden="true" />
                  </div>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="mt-6 border-t border-slate-100 pt-5">
          <a
            href={getLocalizedPath(locale, 'contact')}
            class="inline-flex h-10 w-full items-center justify-center gap-2 rounded-md bg-emerald-600 px-5 text-sm font-semibold text-white transition-colors hover:bg-emerald-700"
          >
            <span>{c.ctaLabel}</span>
            <ArrowRight className="h-4 w-4" aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

