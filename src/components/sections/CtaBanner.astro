---
import { CopyIconButton } from '@/components/common/CopyIconButton';
import { COMPANY } from '@/data/company';
import { getDictionary, getLocalizedPath, type Locale } from '@/i18n';
import { ArrowRight, Mail } from 'lucide-react';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
---

<section class="border-t border-slate-200 bg-white py-16">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex flex-col justify-between gap-6 rounded-md border border-slate-200 bg-slate-50 p-6 sm:p-8 lg:flex-row lg:items-center">
      <div class="max-w-2xl">
        <p class="text-xs font-semibold tracking-wider text-emerald-700 uppercase">
          {dict.ctaBanner.eyebrow}
        </p>
        <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
          {dict.ctaBanner.title}
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-slate-600 sm:text-base">
          {dict.ctaBanner.subtitle}
        </p>
      </div>

      <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
        <div class="flex items-center justify-between gap-2 rounded-md border border-slate-200 bg-white px-3 py-2">
          <div class="flex items-center gap-2">
            <Mail className="h-4 w-4 text-slate-500" aria-hidden="true" />
            <span class="text-xs font-medium text-slate-800">
              {COMPANY.email}
            </span>
          </div>
          <CopyIconButton
            client:idle
            value={COMPANY.email}
            label={dict.ctaBanner.copyEmailTooltip}
            copiedLabel={dict.ctaBanner.copiedTooltip}
          />
        </div>

        <a
          href={getLocalizedPath(locale, 'contact')}
          class="inline-flex h-10 items-center justify-center gap-2 rounded-md bg-emerald-600 px-5 text-sm font-semibold text-white transition-colors hover:bg-emerald-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 focus-visible:ring-offset-2"
        >
          <span>{dict.ctaBanner.primaryButton}</span>
          <ArrowRight className="h-4 w-4" aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>
</section>
