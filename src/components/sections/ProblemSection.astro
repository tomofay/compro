---
import { getDictionary, type Locale } from '@/i18n';
import { AlertCircle, Layers, Store } from 'lucide-react';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const p = dict.problemSection;
const icons = [AlertCircle, Store, Layers];
---

<section class="border-y border-neutral-200/80 bg-[#F4F4F5] py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div data-reveal="" class="flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
      <div>
        <p class="text-xs font-semibold tracking-wider text-emerald-700 uppercase">
          {p.eyebrow}
        </p>
        <h2 class="font-heading mt-2 text-2xl font-semibold tracking-[-0.025em] text-neutral-950 sm:text-3xl">
          {p.titlePrefix}{' '}
          <span class="text-emerald-600">{p.titleAccent}</span>
        </h2>
      </div>
      <p class="text-sm text-neutral-600">
        {p.subtitle}
      </p>
    </div>

    <div class="mt-10 grid grid-cols-1 items-center gap-7 lg:grid-cols-12">
      <div data-reveal="" style="--reveal-delay: 60ms" class="lg:col-span-6">
        <figure class="overflow-hidden rounded-xl border border-neutral-200 bg-white p-2">
          <div class="aspect-video w-full overflow-hidden rounded-lg border border-neutral-200/70 bg-neutral-100">
            <img
              src="/images/enterprise-meeting.jpg"
              alt={p.imageCaption}
              width="1376"
              height="768"
              loading="eager"
              class="h-full w-full object-cover transition-transform duration-500 ease-out hover:scale-[1.02]"
            />
          </div>
          <figcaption class="px-2 pt-2.5 pb-1 text-xs font-medium text-neutral-600">
            {p.imageCaption}
          </figcaption>
        </figure>
      </div>

      <div class="space-y-3.5 lg:col-span-6">
        {
          p.items.map((item, idx) => {
            const Icon = icons[idx] ?? AlertCircle;
            return (
              <div
                data-reveal=""
                style={`--reveal-delay: ${idx * 80}ms`}
                class="flex items-start gap-3.5 rounded-xl border border-neutral-200 bg-white p-5 transition-colors duration-150 hover:border-neutral-300"
              >
                <div class="shrink-0 rounded-lg border border-neutral-200 bg-[#FAFAFA] p-2 text-emerald-700">
                  <Icon className="h-4 w-4" aria-hidden="true" />
                </div>
                <div>
                  <h3 class="font-heading text-sm font-semibold tracking-[-0.015em] text-neutral-950 sm:text-base">
                    {item.title}
                  </h3>
                  <p class="mt-1 text-xs leading-relaxed text-neutral-600 sm:text-sm">
                    {item.description}
                  </p>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>
