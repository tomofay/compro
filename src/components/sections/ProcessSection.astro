---
import { PROCESS_PHASES } from '@/data/techStack';
import { getDictionary, type Locale } from '@/i18n';
import { CheckCircle2 } from 'lucide-react';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
---

<section class="border-t border-neutral-200/80 bg-[#F4F4F5] py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div data-reveal="" class="max-w-2xl">
      <p class="text-xs font-semibold tracking-wider text-emerald-700 uppercase">
        {dict.processSection.eyebrow}
      </p>
      <h2 class="font-heading mt-2 text-2xl font-bold tracking-tight text-neutral-900 sm:text-3xl">
        {dict.processSection.title}
      </h2>
      <p class="mt-2 text-sm text-neutral-600 sm:text-base">
        {dict.processSection.subtitle}
      </p>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
      {
        PROCESS_PHASES.map((phase, idx) => (
          <div
            data-reveal=""
            style={`--reveal-delay: ${idx * 80}ms`}
            class="flex flex-col justify-between rounded-2xl border border-neutral-200/80 bg-white p-5 shadow-sm transition-all duration-200 ease-out hover:-translate-y-1 hover:border-emerald-200 hover:shadow-lg"
          >
            <div>
              <div class="flex items-center justify-between gap-2 border-b border-neutral-100 pb-3">
                <span class="font-mono text-xs font-bold text-emerald-700 uppercase">
                  {dict.processSection.stepLabel} {phase.step}
                </span>
                <span class="rounded-md border border-neutral-200 bg-neutral-50 px-2 py-0.5 font-mono text-[11px] font-medium text-neutral-600 tabular-nums">
                  {phase.duration[locale]}
                </span>
              </div>
              <h3 class="font-heading mt-3.5 text-base font-semibold text-neutral-900">
                {phase.title[locale]}
              </h3>
              <ul class="mt-3 space-y-2">
                {phase.points[locale].map((point) => (
                  <li class="flex items-start gap-2 text-xs leading-relaxed text-neutral-600">
                    <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-500" aria-hidden="true" />
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="mt-5 flex items-start gap-2 border-t border-neutral-100 pt-3 text-xs font-semibold text-neutral-800">
              <CheckCircle2 className="mt-0.5 h-3.5 w-3.5 shrink-0 text-emerald-600" aria-hidden="true" />
              <span>{phase.artifact[locale]}</span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
