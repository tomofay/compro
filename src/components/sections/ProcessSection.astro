---
import { PROCESS_PHASES } from '@/data/techStack';
import { getDictionary, type Locale } from '@/i18n';
import { CheckCircle2 } from 'lucide-react';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
---

<section class="border-t border-slate-200 bg-white py-16">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="max-w-2xl">
      <p class="text-xs font-semibold tracking-wider text-emerald-700 uppercase">
        {dict.processSection.eyebrow}
      </p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        {dict.processSection.title}
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-slate-600 sm:text-base">
        {dict.processSection.subtitle}
      </p>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
      {
        PROCESS_PHASES.map((phase) => (
          <div class="flex flex-col justify-between rounded-md border border-slate-200 bg-slate-50 p-6">
            <div>
              <div class="flex items-center justify-between gap-2 border-b border-slate-200 pb-3">
                <span class="text-xs font-bold text-emerald-700 uppercase">
                  {dict.processSection.stepLabel} {phase.step}
                </span>
                <span class="rounded-sm border border-slate-200 bg-white px-2 py-0.5 font-mono text-[11px] font-medium text-slate-600 tabular-nums">
                  {phase.duration[locale]}
                </span>
              </div>
              <h3 class="mt-4 text-base font-semibold text-slate-900">
                {phase.title[locale]}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">
                {phase.description[locale]}
              </p>
            </div>
            <div class="mt-6 flex items-start gap-2 border-t border-slate-200 pt-3 text-xs font-medium text-slate-700">
              <CheckCircle2 className="mt-0.5 h-3.5 w-3.5 shrink-0 text-emerald-600" aria-hidden="true" />
              <span>{phase.artifact[locale]}</span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
