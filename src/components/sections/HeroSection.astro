---
import { HeroShowcase } from '@/components/sections/HeroShowcase';
import { getDictionary, getLocalizedPath, type Locale } from '@/i18n';
import {
  ArrowRight,
  ArrowUpRight,
  Building2,
  CreditCard,
  Gauge,
  ShieldCheck,
} from 'lucide-react';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const servicesUrl = getLocalizedPath(locale, 'services');
const contactUrl = getLocalizedPath(locale, 'contact');

const pillarIcons = [Gauge, Building2, CreditCard, ShieldCheck];
---

<section class="overflow-hidden bg-[#FAFAFA] pt-12 pb-16 sm:pt-16 sm:pb-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-3xl text-center">
      <h1 class="font-heading text-4xl font-bold tracking-[-0.035em] text-neutral-950 sm:text-5xl lg:text-[3.35rem] lg:leading-[1.06]">
        {dict.hero.headlinePrefix}{' '}
        <span class="text-emerald-600">{dict.hero.headlineAccent}</span>{' '}
        {dict.hero.headlineSuffix}
      </h1>

      <p class="mx-auto mt-4 max-w-xl text-sm leading-relaxed text-neutral-600 sm:text-base">
        {dict.hero.subheadline}
      </p>

      <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
        <a
          href={contactUrl}
          class="group inline-flex h-11 items-center justify-center gap-2 rounded-lg bg-emerald-600 px-6 text-sm font-medium whitespace-nowrap text-white transition-colors duration-150 hover:bg-emerald-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2"
        >
          <span>{dict.hero.primaryCta}</span>
          <ArrowRight
            className="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5"
            aria-hidden="true"
          />
        </a>
        <a
          href={servicesUrl}
          class="inline-flex h-11 items-center justify-center gap-2 rounded-lg border border-neutral-200 bg-white px-6 text-sm font-medium whitespace-nowrap text-neutral-900 transition-colors duration-150 hover:border-neutral-300 hover:bg-neutral-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2"
        >
          <span>{dict.hero.secondaryCta}</span>
          <ArrowUpRight className="h-4 w-4 text-neutral-500" aria-hidden="true" />
        </a>
      </div>
    </div>

    <div class="mx-auto mt-8 max-w-5xl overflow-hidden rounded-xl border border-neutral-200 bg-white">
      <div class="grid grid-cols-1 divide-y divide-neutral-200/80 sm:grid-cols-2 sm:divide-x lg:grid-cols-4 lg:divide-y-0 sm:[&>*:nth-child(odd)]:border-l-0 lg:[&>*:nth-child(odd)]:border-l lg:[&>*:first-child]:border-l-0">
        {
          dict.hero.pillars.map((pillar, idx) => {
            const Icon = pillarIcons[idx] ?? Building2;
            return (
              <div class="flex items-start gap-3 p-4 text-left">
                <div class="shrink-0 rounded-md border border-neutral-200 bg-[#FAFAFA] p-1.5 text-emerald-700">
                  <Icon className="h-3.5 w-3.5" aria-hidden="true" />
                </div>
                <div class="min-w-0">
                  <h2 class="font-heading text-xs font-semibold tracking-[-0.01em] text-neutral-950">
                    {pillar.title}
                  </h2>
                  <p class="mt-0.5 text-[11px] leading-snug text-neutral-600">
                    {pillar.description}
                  </p>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>

  <HeroShowcase client:load locale={locale} caption={dict.hero.galleryCaption} />
</section>
