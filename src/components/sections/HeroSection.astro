---
import { SERVICES } from '@/data/services';
import { getDictionary, getLocalizedPath, type Locale } from '@/i18n';
import {
  ArrowRight,
  ArrowUpRight,
  Building2,
  CreditCard,
  Gauge,
  ShieldCheck,
} from 'lucide-react';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const servicesUrl = getLocalizedPath(locale, 'services');
const contactUrl = getLocalizedPath(locale, 'contact');

const pillarIcons = [Gauge, Building2, CreditCard, ShieldCheck];
---

<section class="bg-white pt-12 pb-14 sm:pt-16 sm:pb-18">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-3xl text-center">
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-5xl sm:leading-[1.12]">
        {dict.hero.headlinePrefix}{' '}
        <span class="text-emerald-600">{dict.hero.headlineAccent}</span>{' '}
        {dict.hero.headlineSuffix}
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-slate-600 sm:text-lg">
        {dict.hero.subheadline}
      </p>

      <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
        <a
          href={contactUrl}
          class="inline-flex h-11 items-center justify-center gap-2 rounded-md bg-emerald-600 px-6 text-sm font-semibold text-white transition-colors hover:bg-emerald-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 focus-visible:ring-offset-2"
        >
          <span>{dict.hero.primaryCta}</span>
          <ArrowRight className="h-4 w-4" aria-hidden="true" />
        </a>
        <a
          href={servicesUrl}
          class="inline-flex h-11 items-center justify-center gap-2 rounded-md border border-slate-200 bg-white px-6 text-sm font-semibold text-slate-800 transition-colors hover:border-slate-300 hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 focus-visible:ring-offset-2"
        >
          <span>{dict.hero.secondaryCta}</span>
          <ArrowUpRight className="h-4 w-4 text-slate-500" aria-hidden="true" />
        </a>
      </div>
    </div>

    <div class="mt-10 overflow-hidden rounded-md border border-slate-200 bg-white">
      <div class="grid grid-cols-1 divide-y divide-slate-200 sm:grid-cols-2 sm:divide-y-0 lg:grid-cols-4 lg:divide-x">
        {
          dict.hero.pillars.map((pillar, idx) => {
            const Icon = pillarIcons[idx] ?? Building2;
            return (
              <div
                class:list={[
                  'p-5',
                  idx === 1 || idx === 3 ? 'sm:border-l sm:border-slate-200 lg:border-l-0' : '',
                  idx >= 2 ? 'sm:border-t sm:border-slate-200 lg:border-t-0' : '',
                ]}
              >
                <div class="flex items-start gap-3">
                  <div class="shrink-0 rounded-md border border-emerald-200 bg-emerald-50 p-2 text-emerald-700">
                    <Icon className="h-4 w-4" aria-hidden="true" />
                  </div>
                  <div>
                    <h2 class="text-sm font-semibold text-slate-900">
                      {pillar.title}
                    </h2>
                    <p class="mt-1 text-xs leading-relaxed text-slate-600">
                      {pillar.description}
                    </p>
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>

    <div class="mt-10">
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
        {
          SERVICES.map((service) => (
            <a
              href={`${servicesUrl}#${service.slug}`}
              class="group overflow-hidden rounded-md border border-slate-200 bg-slate-50 transition-colors hover:border-emerald-400 hover:bg-white"
            >
              <div class="aspect-video w-full overflow-hidden border-b border-slate-200 bg-slate-100">
                <img
                  src={service.image}
                  alt={service.title[locale]}
                  loading="eager"
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
                />
              </div>
              <div class="flex items-center justify-between gap-2 px-3 py-2.5">
                <span class="truncate text-xs font-semibold text-slate-800 group-hover:text-emerald-700">
                  {service.shortLabel[locale]}
                </span>
                <ArrowUpRight className="h-3.5 w-3.5 shrink-0 text-slate-400 group-hover:text-emerald-600" aria-hidden="true" />
              </div>
            </a>
          ))
        }
      </div>
      <p class="mt-3 text-center text-xs text-slate-500">
        {dict.hero.galleryCaption}
      </p>
    </div>
  </div>
</section>
