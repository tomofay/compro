---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ServiceIcon } from '@/components/icons/ServiceIcon';
import { ServicesFaqAccordion } from '@/components/sections/ServicesFaqAccordion';
import CtaBanner from '@/components/sections/CtaBanner.astro';
import { ENGAGEMENT_MODELS, SERVICES } from '@/data/services';
import { getDictionary, getLocalizedPath, type Locale } from '@/i18n';
import { ArrowUpRight, CheckCircle2 } from 'lucide-react';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const contactUrl = getLocalizedPath(locale, 'contact');
---

<BaseLayout
  locale={locale}
  currentPage="services"
  title={dict.meta.servicesTitle}
  description={dict.meta.servicesDescription}
>
  <section class="border-b border-neutral-200/80 bg-[#F4F4F5] py-14 sm:py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <p class="text-xs font-semibold tracking-wider text-emerald-700 uppercase">
        {dict.servicesPage.eyebrow}
      </p>
      <h1 class="font-heading mt-2 max-w-3xl text-3xl font-bold tracking-[-0.03em] text-neutral-950 sm:text-4xl">
        {dict.servicesPage.title}
      </h1>
      <p class="mt-2.5 max-w-2xl text-sm text-neutral-600 sm:text-base">
        {dict.servicesPage.subtitle}
      </p>
    </div>
  </section>

  <section class="bg-[#FAFAFA] py-16">
    <div class="mx-auto max-w-6xl space-y-6 px-4 sm:px-6">
      {
        SERVICES.map((service, idx) => (
          <article
            id={service.slug}
            data-reveal=""
            style={`--reveal-delay: ${Math.min(idx, 2) * 80}ms`}
            class="scroll-mt-24 overflow-hidden rounded-2xl border border-neutral-200/80 bg-white shadow-sm transition-shadow duration-200 hover:shadow-md"
          >
            <div class="grid grid-cols-1 lg:grid-cols-12">
              <div class="border-b border-neutral-200 bg-[#FAFAFA] p-5 lg:col-span-5 lg:border-r lg:border-b-0">
                <div class="aspect-video w-full overflow-hidden rounded-lg border border-neutral-200 bg-white">
                  <img
                    src={service.image}
                    alt={service.title[locale]}
                    width="1376"
                    height="768"
                    loading="eager"
                    class="h-full w-full object-cover"
                  />
                </div>

                <dl class="mt-4 divide-y divide-neutral-200 rounded-lg border border-neutral-200 bg-white text-xs">
                  <div class="flex items-start justify-between gap-4 px-3.5 py-2.5">
                    <dt class="w-28 shrink-0 text-neutral-500">{dict.servicesPage.investmentLabel}</dt>
                    <dd class="font-heading text-right font-semibold tracking-tight text-neutral-950 tabular-nums">
                      {service.startingPrice[locale]}
                    </dd>
                  </div>
                  <div class="flex items-start justify-between gap-4 px-3.5 py-2.5">
                    <dt class="w-28 shrink-0 text-neutral-500">{dict.servicesPage.timelineLabel}</dt>
                    <dd class="text-right font-medium text-neutral-800 tabular-nums">
                      {service.timeline[locale]}
                    </dd>
                  </div>
                  <div class="flex items-start justify-between gap-4 px-3.5 py-2.5">
                    <dt class="w-28 shrink-0 text-neutral-500">{dict.servicesPage.hostingLabel}</dt>
                    <dd class="text-right font-medium leading-snug text-neutral-800">
                      {service.hostingPolicy[locale]}
                    </dd>
                  </div>
                  <div class="flex items-start justify-between gap-4 px-3.5 py-2.5">
                    <dt class="w-28 shrink-0 text-neutral-500">{dict.servicesPage.idealForLabel}</dt>
                    <dd class="text-right font-medium leading-snug text-neutral-800">
                      {service.idealFor[locale]}
                    </dd>
                  </div>
                </dl>
              </div>

              <div class="flex flex-col justify-between p-6 sm:p-7 lg:col-span-7">
                <div>
                  <div class="flex items-center gap-3">
                    <div class="rounded-xl border border-emerald-100 bg-emerald-50 p-2 text-emerald-700">
                      <ServiceIcon name={service.icon} className="h-4 w-4" />
                    </div>
                    <h2 class="font-heading text-xl font-bold tracking-tight text-neutral-900 sm:text-2xl">
                      {service.title[locale]}
                    </h2>
                  </div>

                  <p class="mt-2.5 text-sm text-neutral-600">
                    {service.tagline[locale]}
                  </p>

                  <h3 class="mt-5 text-xs font-semibold tracking-wider text-neutral-900 uppercase">
                    {dict.servicesPage.deliverablesLabel}
                  </h3>
                  <ul class="mt-3 space-y-2">
                    {service.deliverables[locale].map((item) => (
                      <li class="flex items-start gap-2.5 text-sm text-neutral-700">
                        <CheckCircle2
                          className="mt-0.5 h-4 w-4 shrink-0 text-emerald-600"
                          aria-hidden="true"
                        />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-neutral-100 pt-5">
                  <div class="flex flex-wrap gap-1.5">
                    {service.highlights[locale].map((highlight) => (
                      <span class="rounded-md border border-neutral-200/80 bg-neutral-50 px-2.5 py-1 text-xs font-medium text-neutral-700">
                        {highlight}
                      </span>
                    ))}
                  </div>
                  <a
                    href={`${contactUrl}?service=${service.categoryKey}`}
                    class="inline-flex h-10 items-center gap-2 rounded-lg bg-emerald-600 px-5 text-xs font-semibold text-white shadow-sm transition-all duration-200 ease-out hover:-translate-y-0.5 hover:bg-emerald-700 hover:shadow-md"
                  >
                    <span>{dict.servicesSection.inquireServiceLabel}</span>
                    <ArrowUpRight className="h-3.5 w-3.5" aria-hidden="true" />
                  </a>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="border-t border-neutral-200/80 bg-[#F4F4F5] py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div data-reveal="" class="max-w-2xl">
        <h2 class="font-heading text-2xl font-bold tracking-tight text-neutral-900 sm:text-3xl">
          {dict.servicesPage.engagementTitle}
        </h2>
        <p class="mt-2 text-sm text-neutral-600 sm:text-base">
          {dict.servicesPage.engagementSubtitle}
        </p>
      </div>

      <div class="mt-7 grid grid-cols-1 gap-5 md:grid-cols-3">
        {
          ENGAGEMENT_MODELS.map((model, idx) => (
            <div
              data-reveal=""
              style={`--reveal-delay: ${idx * 80}ms`}
              class="rounded-2xl border border-neutral-200/80 bg-white p-6 shadow-sm transition-all duration-200 ease-out hover:-translate-y-1 hover:border-emerald-200 hover:shadow-lg"
            >
              <div class="flex items-center justify-between border-b border-neutral-100 pb-3">
                <span class="font-mono text-xs font-bold text-emerald-700">
                  {String(idx + 1).padStart(2, '0')}
                </span>
                <span class="text-xs font-medium text-neutral-500">
                  {model.billingType[locale]}
                </span>
              </div>
              <h3 class="font-heading mt-4 text-base font-semibold text-neutral-900">
                {model.title[locale]}
              </h3>
              <p class="mt-1.5 text-xs text-neutral-600">
                {model.bestFor[locale]}
              </p>
              <ul class="mt-4 space-y-2 border-t border-neutral-100 pt-4">
                {model.terms[locale].map((term) => (
                  <li class="flex items-start gap-2 text-xs text-neutral-700">
                    <CheckCircle2
                      className="mt-0.5 h-3.5 w-3.5 shrink-0 text-emerald-600"
                      aria-hidden="true"
                    />
                    <span>{term}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-t border-neutral-200/80 bg-[#FAFAFA] py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div data-reveal="" class="mb-7 text-center">
        <h2 class="font-heading text-2xl font-bold tracking-tight text-neutral-900 sm:text-3xl">
          {dict.servicesPage.faqTitle}
        </h2>
        <p class="mx-auto mt-2 max-w-xl text-sm text-neutral-600">
          {dict.servicesPage.faqSubtitle}
        </p>
      </div>
      <ServicesFaqAccordion client:load locale={locale} />
    </div>
  </section>

  <CtaBanner locale={locale} />
</BaseLayout>
