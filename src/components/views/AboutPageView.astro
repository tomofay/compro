---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TechStackMatrix from '@/components/sections/TechStackMatrix.astro';
import CtaBanner from '@/components/sections/CtaBanner.astro';
import { COMPANY } from '@/data/company';
import { getDictionary, type Locale } from '@/i18n';
import { Building2, CheckCircle2, ShieldCheck } from 'lucide-react';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
---

<BaseLayout
  locale={locale}
  currentPage="about"
  title={dict.meta.aboutTitle}
  description={dict.meta.aboutDescription}
>
  <section class="border-b border-neutral-200/80 bg-[#F4F4F5] py-14 sm:py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <p class="text-xs font-semibold tracking-wider text-emerald-700 uppercase">
        {dict.aboutPage.eyebrow}
      </p>
      <h1 class="font-heading mt-2 max-w-3xl text-3xl font-extrabold tracking-tight text-neutral-900 sm:text-4xl">
        {dict.aboutPage.title}
      </h1>
      <p class="mt-2.5 max-w-2xl text-sm text-neutral-600 sm:text-base">
        {dict.aboutPage.subtitle}
      </p>
    </div>
  </section>

  <section class="bg-[#FAFAFA] py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-12">
        <div data-reveal="" class="lg:col-span-6">
          <div class="overflow-hidden rounded-2xl border border-emerald-100 bg-white p-2 shadow-[0_12px_32px_-12px_rgba(5,150,105,0.12)]">
            <div class="aspect-video w-full overflow-hidden rounded-xl border border-neutral-100 bg-neutral-100">
              <img
                src="/images/about-studio.jpg"
                alt={COMPANY.legalName}
                width="1376"
                height="768"
                loading="eager"
                class="h-full w-full object-cover"
              />
            </div>
          </div>
        </div>

        <div data-reveal="" style="--reveal-delay: 80ms" class="lg:col-span-6">
          <div class="flex items-center gap-3">
            <div class="rounded-xl border border-emerald-100 bg-emerald-50 p-2 text-emerald-700">
              <Building2 className="h-4 w-4" aria-hidden="true" />
            </div>
            <h2 class="font-heading text-xl font-bold tracking-tight text-neutral-900 sm:text-2xl">
              {dict.aboutPage.overviewTitle}
            </h2>
          </div>
          <ul class="mt-5 space-y-3">
            {
              dict.aboutPage.overviewPoints.map((point) => (
                <li class="flex items-start gap-2.5 text-sm leading-relaxed text-neutral-700">
                  <CheckCircle2
                    className="mt-0.5 h-4 w-4 shrink-0 text-emerald-600"
                    aria-hidden="true"
                  />
                  <span>{point}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="mt-12">
        <h2 class="font-heading text-xs font-semibold tracking-wider text-neutral-900 uppercase">
          {dict.aboutPage.principlesTitle}
        </h2>
        <div class="mt-4 grid grid-cols-1 gap-5 md:grid-cols-3">
          {
            dict.aboutPage.principles.map((item, idx) => (
              <div
                data-reveal=""
                style={`--reveal-delay: ${idx * 80}ms`}
                class="rounded-2xl border border-neutral-200/80 bg-white p-5 shadow-sm transition-all duration-200 ease-out hover:-translate-y-1 hover:border-emerald-200 hover:shadow-lg"
              >
                <div class="font-mono text-xs font-bold text-emerald-700">
                  {String(idx + 1).padStart(2, '0')}
                </div>
                <h3 class="font-heading mt-2 text-base font-semibold text-neutral-900">
                  {item.title}
                </h3>
                <p class="mt-1 text-xs leading-relaxed text-neutral-600 sm:text-sm">
                  {item.description}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <TechStackMatrix locale={locale} />

  <section class="border-t border-neutral-200/80 bg-[#FAFAFA] py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div data-reveal="" class="flex items-start gap-3">
        <div class="rounded-xl border border-emerald-100 bg-emerald-50 p-2 text-emerald-700">
          <ShieldCheck className="h-4 w-4" aria-hidden="true" />
        </div>
        <div>
          <h2 class="font-heading text-xl font-bold tracking-tight text-neutral-900 sm:text-2xl">
            {dict.aboutPage.legalTitle}
          </h2>
          <p class="mt-1 text-sm text-neutral-600">
            {dict.aboutPage.legalSubtitle}
          </p>
        </div>
      </div>

      <div
        data-reveal=""
        style="--reveal-delay: 80ms"
        class="mt-6 overflow-hidden rounded-2xl border border-neutral-200/80 bg-white shadow-sm"
      >
        <dl class="divide-y divide-neutral-200/80">
          {
            COMPANY.legalRegistry.map((row) => (
              <div class="grid grid-cols-1 gap-2 px-5 py-3.5 text-sm sm:grid-cols-12 sm:items-center">
                <dt class="font-medium text-neutral-700 sm:col-span-4">
                  {row.label[locale]}
                </dt>
                <dd class="font-mono text-xs text-neutral-900 sm:col-span-8 sm:text-right">
                  {row.value}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <CtaBanner locale={locale} />
</BaseLayout>
