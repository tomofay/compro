---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TechStackMatrix from '@/components/sections/TechStackMatrix.astro';
import CtaBanner from '@/components/sections/CtaBanner.astro';
import { COMPANY } from '@/data/company';
import { getDictionary, type Locale } from '@/i18n';
import { Building2, CheckCircle2 } from 'lucide-react';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
---

<BaseLayout
  locale={locale}
  currentPage="about"
  title={dict.meta.aboutTitle}
  description={dict.meta.aboutDescription}
>
  <section class="border-b border-slate-200 bg-white py-14 sm:py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <p class="font-mono text-xs font-semibold tracking-wider text-indigo-600 uppercase">
        {dict.aboutPage.eyebrow}
      </p>
      <h1 class="font-heading mt-2 max-w-3xl text-3xl font-bold tracking-[-0.03em] text-slate-900 sm:text-4xl">
        {dict.aboutPage.title}
      </h1>
      <p class="mt-2.5 max-w-2xl text-sm text-slate-600 sm:text-base">
        {dict.aboutPage.subtitle}
      </p>
    </div>
  </section>

  <section class="bg-slate-50 py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-12">
        <div data-reveal="" class="lg:col-span-6">
          <div class="overflow-hidden rounded-xl border border-slate-200 bg-white p-2">
            <div class="aspect-video w-full overflow-hidden rounded-lg border border-slate-200 bg-slate-100">
              <img
                src="/images/about-studio.jpg"
                alt={COMPANY.legalName}
                width="1376"
                height="768"
                loading="eager"
                class="h-full w-full object-cover"
              />
            </div>
          </div>
        </div>

        <div data-reveal="" style="--reveal-delay: 80ms" class="lg:col-span-6">
          <div class="flex items-center gap-3">
            <div class="rounded-xl border border-indigo-100 bg-indigo-50 p-2 text-indigo-600">
              <Building2 className="h-4 w-4" aria-hidden="true" />
            </div>
            <h2 class="font-heading text-xl font-semibold tracking-[-0.025em] text-slate-900 sm:text-2xl">
              {dict.aboutPage.overviewTitle}
            </h2>
          </div>
          <ul class="mt-5 space-y-3">
            {
              dict.aboutPage.overviewPoints.map((point) => (
                <li class="flex items-start gap-2.5 text-sm leading-relaxed text-slate-700">
                  <CheckCircle2
                    className="mt-0.5 h-4 w-4 shrink-0 text-indigo-600"
                    aria-hidden="true"
                  />
                  <span>{point}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="mt-12">
        <h2 class="font-heading text-xs font-semibold tracking-wider text-slate-900 uppercase">
          {dict.aboutPage.principlesTitle}
        </h2>
        <div class="mt-4 grid grid-cols-1 gap-5 md:grid-cols-3">
          {
            dict.aboutPage.principles.map((item, idx) => (
              <div
                data-reveal=""
                style={`--reveal-delay: ${idx * 80}ms`}
                class="rounded-2xl border border-slate-200 bg-white p-5 transition-all duration-200 ease-out hover:-translate-y-0.5 hover:border-indigo-300"
              >
                <div class="font-mono text-xs font-bold text-indigo-600">
                  {String(idx + 1).padStart(2, '0')}
                </div>
                <h3 class="font-heading mt-2 text-base font-semibold text-slate-900">
                  {item.title}
                </h3>
                <p class="mt-1 text-xs leading-relaxed text-slate-600 sm:text-sm">
                  {item.description}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <TechStackMatrix locale={locale} />

  <CtaBanner locale={locale} surface="light" />
</BaseLayout>
