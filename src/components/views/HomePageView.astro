---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSection from '@/components/sections/HeroSection.astro';
import ProblemSection from '@/components/sections/ProblemSection.astro';
import { ServicesShowcase } from '@/components/sections/ServicesShowcase';
import ComparisonSection from '@/components/sections/ComparisonSection.astro';
import { PortfolioExplorer } from '@/components/sections/PortfolioExplorer';
import ProcessSection from '@/components/sections/ProcessSection.astro';
import { ContactInquiryForm } from '@/components/sections/ContactInquiryForm';
import { CopyIconButton } from '@/components/common/CopyIconButton';
import { COMPANY } from '@/data/company';
import { getDictionary, type Locale } from '@/i18n';
import { Mail, MessageSquare } from 'lucide-react';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
---

<BaseLayout
  locale={locale}
  currentPage="home"
  description={dict.meta.homeDescription}
>
  <HeroSection locale={locale} />
  <ProblemSection locale={locale} />
  <ServicesShowcase client:load locale={locale} />
  <ComparisonSection locale={locale} />
  <PortfolioExplorer client:load locale={locale} compact={true} />
  <ProcessSection locale={locale} />

  <section class="border-t border-slate-200 bg-slate-50 py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-12">
        <div class="space-y-5 lg:col-span-5">
          <div>
            <p class="text-xs font-semibold tracking-wider text-emerald-700 uppercase">
              {dict.ctaBanner.eyebrow}
            </p>
            <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
              {dict.ctaBanner.title}
            </h2>
            <p class="mt-3 text-sm leading-relaxed text-slate-600 sm:text-base">
              {dict.ctaBanner.subtitle}
            </p>
          </div>

          <figure class="overflow-hidden rounded-md border border-slate-200 bg-white">
            <div class="aspect-video w-full overflow-hidden bg-slate-100">
              <img
                src="/images/about-studio.jpg"
                alt={COMPANY.legalName}
                width="1376"
                height="768"
                loading="eager"
                class="h-full w-full object-cover"
              />
            </div>
          </figure>

          <div class="space-y-2.5">
            <div class="flex items-center justify-between gap-2 rounded-md border border-slate-200 bg-white px-3.5 py-2.5">
              <div class="flex min-w-0 items-center gap-2.5">
                <Mail className="h-4 w-4 shrink-0 text-emerald-600" aria-hidden="true" />
                <span class="truncate text-xs font-medium text-slate-800">{COMPANY.email}</span>
              </div>
              <CopyIconButton
                client:idle
                value={COMPANY.email}
                label={dict.ctaBanner.copyEmailTooltip}
                copiedLabel={dict.ctaBanner.copiedTooltip}
              />
            </div>

            <div class="flex items-center justify-between gap-2 rounded-md border border-slate-200 bg-white px-3.5 py-2.5">
              <div class="flex min-w-0 items-center gap-2.5">
                <MessageSquare className="h-4 w-4 shrink-0 text-emerald-600" aria-hidden="true" />
                <span class="truncate font-mono text-xs font-medium text-slate-800">
                  {COMPANY.whatsappDisplay}
                </span>
              </div>
              <CopyIconButton
                client:idle
                value={COMPANY.whatsappDisplay}
                label={dict.contactPage.copyTooltip}
                copiedLabel={dict.contactPage.copiedTooltip}
              />
            </div>
          </div>
        </div>

        <div class="lg:col-span-7">
          <ContactInquiryForm client:load locale={locale} />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
