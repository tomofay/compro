---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSection from '@/components/sections/HeroSection.astro';
import ProblemSection from '@/components/sections/ProblemSection.astro';
import { ServicesShowcase } from '@/components/sections/ServicesShowcase';
import ComparisonSection from '@/components/sections/ComparisonSection.astro';
import { ShowcaseExplorer } from '@/components/sections/ShowcaseExplorer';
import ProcessSection from '@/components/sections/ProcessSection.astro';
import CtaBanner from '@/components/sections/CtaBanner.astro';
import { ServicesFaqAccordion } from '@/components/sections/ServicesFaqAccordion';
import { getDictionary, getLocalizedPath, type Locale } from '@/i18n';
import { ArrowUpRight } from 'lucide-react';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
---

<BaseLayout
  locale={locale}
  currentPage="home"
  description={dict.meta.homeDescription}
>
  <HeroSection locale={locale} />
  <ProblemSection locale={locale} />
  <ServicesShowcase client:load locale={locale} />
  <ComparisonSection locale={locale} />
  <ShowcaseExplorer client:load locale={locale} compact={true} />
  <ProcessSection locale={locale} />
  <CtaBanner locale={locale} surface="light" />

  <section class="border-t border-slate-200 bg-slate-50 py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div data-reveal="" class="text-center">
        <p class="font-mono text-xs font-semibold tracking-wider text-indigo-600 uppercase">
          FAQ
        </p>
        <h2 class="font-heading mt-2 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
          {dict.servicesPage.faqTitle}
        </h2>
        <p class="mx-auto mt-2 max-w-xl text-sm text-slate-600">
          {dict.servicesPage.faqSubtitle}
        </p>
      </div>

      <div class="mt-7">
        <ServicesFaqAccordion client:load locale={locale} />
      </div>

      <div class="mt-7 text-center">
        <a
          href={getLocalizedPath(locale, 'services')}
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-indigo-600 transition-colors hover:text-indigo-700"
        >
          <span>{dict.servicesSection.viewAllLink}</span>
          <ArrowUpRight className="h-4 w-4" aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
