---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { CopyIconButton } from '@/components/common/CopyIconButton';
import { ContactInquiryForm } from '@/components/sections/ContactInquiryForm';
import { COMPANY } from '@/data/company';
import { getDictionary, type Locale } from '@/i18n';
import { Clock, Mail, MapPin, MessageSquare, Phone } from 'lucide-react';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const c = dict.contactPage;
---

<BaseLayout
  locale={locale}
  currentPage="contact"
  title={dict.meta.contactTitle}
  description={dict.meta.contactDescription}
>
  <section class="border-b border-slate-200 bg-slate-50 py-12 sm:py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <p class="text-xs font-semibold tracking-wider text-emerald-700 uppercase">
        {c.eyebrow}
      </p>
      <h1 class="mt-2 max-w-3xl text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        {c.title}
      </h1>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-600 sm:text-base">
        {c.subtitle}
      </p>
    </div>
  </section>

  <section class="bg-white py-14">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
        <div class="space-y-4 lg:col-span-5">
          <h2 class="text-xs font-semibold tracking-wider text-slate-900 uppercase">
            {c.channelsTitle}
          </h2>

          <div class="divide-y divide-slate-200 rounded-md border border-slate-200 bg-white">
            <div class="flex items-center justify-between gap-3 p-4">
              <div class="flex min-w-0 items-start gap-3">
                <div class="rounded-md border border-slate-200 bg-slate-100 p-2 text-slate-700">
                  <Mail className="h-4 w-4" aria-hidden="true" />
                </div>
                <div class="min-w-0">
                  <div class="text-xs font-medium text-slate-500">{c.channels.email}</div>
                  <div class="truncate font-mono text-xs font-semibold text-slate-900 sm:text-sm">
                    {COMPANY.email}
                  </div>
                </div>
              </div>
              <CopyIconButton
                client:idle
                value={COMPANY.email}
                label={c.copyTooltip}
                copiedLabel={c.copiedTooltip}
              />
            </div>

            <div class="flex items-center justify-between gap-3 p-4">
              <div class="flex min-w-0 items-start gap-3">
                <div class="rounded-md border border-slate-200 bg-slate-100 p-2 text-slate-700">
                  <Mail className="h-4 w-4" aria-hidden="true" />
                </div>
                <div class="min-w-0">
                  <div class="text-xs font-medium text-slate-500">{c.channels.projectsEmail}</div>
                  <div class="truncate font-mono text-xs font-semibold text-slate-900 sm:text-sm">
                    {COMPANY.projectsEmail}
                  </div>
                </div>
              </div>
              <CopyIconButton
                client:idle
                value={COMPANY.projectsEmail}
                label={c.copyTooltip}
                copiedLabel={c.copiedTooltip}
              />
            </div>

            <div class="flex items-center justify-between gap-3 p-4">
              <div class="flex min-w-0 items-start gap-3">
                <div class="rounded-md border border-slate-200 bg-slate-100 p-2 text-slate-700">
                  <MessageSquare className="h-4 w-4" aria-hidden="true" />
                </div>
                <div class="min-w-0">
                  <div class="text-xs font-medium text-slate-500">{c.channels.whatsapp}</div>
                  <div class="truncate font-mono text-xs font-semibold text-slate-900 sm:text-sm">
                    {COMPANY.whatsappDisplay}
                  </div>
                </div>
              </div>
              <CopyIconButton
                client:idle
                value={COMPANY.whatsappDisplay}
                label={c.copyTooltip}
                copiedLabel={c.copiedTooltip}
              />
            </div>

            <div class="flex items-center justify-between gap-3 p-4">
              <div class="flex min-w-0 items-start gap-3">
                <div class="rounded-md border border-slate-200 bg-slate-100 p-2 text-slate-700">
                  <Phone className="h-4 w-4" aria-hidden="true" />
                </div>
                <div class="min-w-0">
                  <div class="text-xs font-medium text-slate-500">{c.channels.phone}</div>
                  <div class="truncate font-mono text-xs font-semibold text-slate-900 sm:text-sm">
                    {COMPANY.phoneDisplay}
                  </div>
                </div>
              </div>
              <CopyIconButton
                client:idle
                value={COMPANY.phoneDisplay}
                label={c.copyTooltip}
                copiedLabel={c.copiedTooltip}
              />
            </div>

            <div class="flex items-start justify-between gap-3 p-4">
              <div class="flex min-w-0 items-start gap-3">
                <div class="rounded-md border border-slate-200 bg-slate-100 p-2 text-slate-700">
                  <MapPin className="h-4 w-4" aria-hidden="true" />
                </div>
                <div>
                  <div class="text-xs font-medium text-slate-500">{c.channels.address}</div>
                  <div class="mt-0.5 text-xs leading-relaxed text-slate-800 sm:text-sm">
                    {COMPANY.address[locale]}
                  </div>
                </div>
              </div>
              <CopyIconButton
                client:idle
                value={COMPANY.address[locale]}
                label={c.copyTooltip}
                copiedLabel={c.copiedTooltip}
              />
            </div>

            <div class="flex items-start gap-3 p-4">
              <div class="rounded-md border border-slate-200 bg-slate-100 p-2 text-slate-700">
                <Clock className="h-4 w-4" aria-hidden="true" />
              </div>
              <div>
                <div class="text-xs font-medium text-slate-500">{c.channels.hours}</div>
                <div class="mt-0.5 font-mono text-xs font-medium text-slate-800">
                  {COMPANY.operatingHours[locale]}
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-7">
          <ContactInquiryForm client:load locale={locale} />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

