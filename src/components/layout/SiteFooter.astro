---
import { BrandWordmark } from '@/components/common/BrandWordmark';
import { CopyIconButton } from '@/components/common/CopyIconButton';
import { COMPANY } from '@/data/company';
import { SERVICES } from '@/data/services';
import { getDictionary, getLocalizedPath, type Locale } from '@/i18n';
import { Mail, MapPin, MessageSquare } from 'lucide-react';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const currentYear = new Date().getFullYear();
---

<footer class="rounded-t-3xl border-t border-emerald-900 bg-[#06281B] text-emerald-50">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="md:col-span-4">
        <a
          href={getLocalizedPath(locale, 'home')}
          aria-label={COMPANY.legalName}
          class="inline-flex items-center rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 focus-visible:ring-offset-2 focus-visible:ring-offset-[#06281B]"
        >
          <BrandWordmark variant="footer" tone="dark" />
        </a>
        <p class="mt-3.5 text-xs leading-relaxed text-emerald-100/90 sm:text-[13px]">
          {dict.footer.tagline}
        </p>
        <div class="mt-5 flex items-start gap-2 text-xs leading-relaxed text-emerald-200/75">
          <MapPin className="mt-0.5 h-3.5 w-3.5 shrink-0 text-emerald-400" aria-hidden="true" />
          <span>{COMPANY.address[locale]}</span>
        </div>
      </div>

      <div class="md:col-span-2">
        <h3 class="font-heading text-xs font-semibold tracking-wider text-white uppercase">
          {dict.footer.navigationTitle}
        </h3>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li>
            <a href={getLocalizedPath(locale, 'home')} class="text-emerald-100/80 transition-colors hover:text-emerald-300">
              {dict.nav.home}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath(locale, 'services')} class="text-emerald-100/80 transition-colors hover:text-emerald-300">
              {dict.nav.services}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath(locale, 'showcase')} class="text-emerald-100/80 transition-colors hover:text-emerald-300">
              {dict.nav.showcase}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath(locale, 'about')} class="text-emerald-100/80 transition-colors hover:text-emerald-300">
              {dict.nav.about}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath(locale, 'contact')} class="text-emerald-100/80 transition-colors hover:text-emerald-300">
              {dict.nav.contact}
            </a>
          </li>
        </ul>
      </div>

      <div class="md:col-span-3">
        <h3 class="font-heading text-xs font-semibold tracking-wider text-white uppercase">
          {dict.footer.servicesTitle}
        </h3>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            SERVICES.map((svc) => (
              <li>
                <a
                  href={`${getLocalizedPath(locale, 'services')}#${svc.slug}`}
                  class="text-emerald-100/80 transition-colors hover:text-emerald-300"
                >
                  {svc.title[locale]}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="md:col-span-3">
        <h3 class="font-heading text-xs font-semibold tracking-wider text-white uppercase">
          {dict.footer.contactTitle}
        </h3>
        <div class="mt-4 space-y-3">
          <div class="flex items-center justify-between gap-2 rounded-xl border border-emerald-800/80 bg-emerald-950/60 px-3 py-2.5">
            <div class="flex min-w-0 items-center gap-2">
              <Mail className="h-3.5 w-3.5 shrink-0 text-emerald-400" aria-hidden="true" />
              <span class="truncate text-xs text-emerald-50">{COMPANY.email}</span>
            </div>
            <CopyIconButton
              client:idle
              tone="dark"
              value={COMPANY.email}
              label={dict.contactPage.copyTooltip}
              copiedLabel={dict.contactPage.copiedTooltip}
            />
          </div>
          <div class="flex items-center justify-between gap-2 rounded-xl border border-emerald-800/80 bg-emerald-950/60 px-3 py-2.5">
            <div class="flex min-w-0 items-center gap-2">
              <MessageSquare className="h-3.5 w-3.5 shrink-0 text-emerald-400" aria-hidden="true" />
              <span class="truncate font-mono text-xs text-emerald-50">{COMPANY.whatsappDisplay}</span>
            </div>
            <CopyIconButton
              client:idle
              tone="dark"
              value={COMPANY.whatsappDisplay}
              label={dict.contactPage.copyTooltip}
              copiedLabel={dict.contactPage.copiedTooltip}
            />
          </div>
        </div>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-start justify-between gap-3 border-t border-emerald-800/70 pt-6 text-xs text-emerald-200/75 sm:flex-row sm:items-center">
      <p>
        &copy; {currentYear} {COMPANY.legalName}. {dict.footer.copyright}
      </p>
      <p class="text-[11px] font-medium text-emerald-200/90">
        {dict.footer.builtNote}
      </p>
    </div>
  </div>
</footer>
