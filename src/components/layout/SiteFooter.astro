---
import { BrandWordmark } from '@/components/common/BrandWordmark';
import { CopyIconButton } from '@/components/common/CopyIconButton';
import { COMPANY } from '@/data/company';
import { SERVICES } from '@/data/services';
import { getDictionary, getLocalizedPath, type Locale } from '@/i18n';
import { Mail, MapPin, Phone } from 'lucide-react';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-slate-50">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-12">
      <div class="md:col-span-4">
        <a
          href={getLocalizedPath(locale, 'home')}
          aria-label={COMPANY.legalName}
          class="inline-flex items-center rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 focus-visible:ring-offset-2"
        >
          <BrandWordmark variant="footer" />
        </a>
        <p class="mt-3 text-[13px] leading-relaxed font-medium text-slate-800">
          {dict.footer.unitAttributionPrefix}<span class="font-semibold text-slate-950">{dict.footer.unitAttributionCompany}</span>
        </p>
        <p class="mt-2 text-xs leading-relaxed text-slate-600 sm:text-[13px]">
          {dict.footer.tagline}
        </p>
        <div class="mt-4 flex items-start gap-2 text-xs leading-relaxed text-slate-500">
          <MapPin className="mt-0.5 h-3.5 w-3.5 shrink-0 text-slate-500" aria-hidden="true" />
          <span>{COMPANY.address[locale]}</span>
        </div>
      </div>

      <div class="md:col-span-2">
        <h3 class="text-xs font-semibold tracking-wider text-slate-900 uppercase">
          {dict.footer.navigationTitle}
        </h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            <a href={getLocalizedPath(locale, 'home')} class="text-slate-600 hover:text-emerald-700">
              {dict.nav.home}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath(locale, 'services')} class="text-slate-600 hover:text-emerald-700">
              {dict.nav.services}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath(locale, 'portfolio')} class="text-slate-600 hover:text-emerald-700">
              {dict.nav.portfolio}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath(locale, 'about')} class="text-slate-600 hover:text-emerald-700">
              {dict.nav.about}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath(locale, 'contact')} class="text-slate-600 hover:text-emerald-700">
              {dict.nav.contact}
            </a>
          </li>
        </ul>
      </div>

      <div class="md:col-span-3">
        <h3 class="text-xs font-semibold tracking-wider text-slate-900 uppercase">
          {dict.footer.servicesTitle}
        </h3>
        <ul class="mt-3 space-y-2 text-sm">
          {
            SERVICES.map((svc) => (
              <li>
                <a
                  href={`${getLocalizedPath(locale, 'services')}#${svc.slug}`}
                  class="text-slate-600 hover:text-emerald-700"
                >
                  {svc.title[locale]}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="md:col-span-3">
        <h3 class="text-xs font-semibold tracking-wider text-slate-900 uppercase">
          {dict.footer.contactTitle}
        </h3>
        <div class="mt-3 space-y-3">
          <div class="flex items-center justify-between gap-2 rounded-md border border-slate-200 bg-white px-3 py-2">
            <div class="flex min-w-0 items-center gap-2">
              <Mail className="h-3.5 w-3.5 shrink-0 text-slate-500" aria-hidden="true" />
              <span class="truncate text-xs text-slate-700">{COMPANY.email}</span>
            </div>
            <CopyIconButton
              client:idle
              value={COMPANY.email}
              label={dict.contactPage.copyTooltip}
              copiedLabel={dict.contactPage.copiedTooltip}
            />
          </div>
          <div class="flex items-center justify-between gap-2 rounded-md border border-slate-200 bg-white px-3 py-2">
            <div class="flex min-w-0 items-center gap-2">
              <Phone className="h-3.5 w-3.5 shrink-0 text-slate-500" aria-hidden="true" />
              <span class="truncate font-mono text-xs text-slate-700">{COMPANY.whatsappDisplay}</span>
            </div>
            <CopyIconButton
              client:idle
              value={COMPANY.whatsappDisplay}
              label={dict.contactPage.copyTooltip}
              copiedLabel={dict.contactPage.copiedTooltip}
            />
          </div>
        </div>
      </div>
    </div>

    <div class="mt-10 flex flex-col items-start justify-between gap-3 border-t border-slate-200 pt-6 text-xs text-slate-500 sm:flex-row sm:items-center">
      <p>
        &copy; {currentYear} {COMPANY.legalName} · {COMPANY.parentCompany}. {dict.footer.copyright}
      </p>
      <p class="text-[11px] font-medium text-slate-600">
        {dict.footer.builtNote}
      </p>
    </div>
  </div>
</footer>
