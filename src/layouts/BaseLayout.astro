---
import '@fontsource-variable/geist';
import '@fontsource-variable/inter';
import '@fontsource-variable/geist-mono';
import '@/styles/global.css';
import { SiteHeader } from '@/components/layout/SiteHeader';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import { COMPANY } from '@/data/company';
import {
  buildAbsoluteUrl,
  buildStructuredData,
  getPageOgImage,
  resolveSiteOrigin,
} from '@/data/seo';
import {
  getDictionary,
  getLocalizedPath,
  type Locale,
  type PageKey,
} from '@/i18n';

interface Props {
  locale: Locale;
  currentPage: PageKey;
  title?: string;
  description?: string;
}

const { locale, currentPage, title, description } = Astro.props;
const dict = getDictionary(locale);

const resolvedTitle = title
  ? `${title} | ${dict.meta.siteTitleSuffix}`
  : dict.meta.homeTitle;
const resolvedDescription = description ?? dict.meta.homeDescription;

const siteOrigin = resolveSiteOrigin(Astro.site);
const canonicalUrl = buildAbsoluteUrl(
  getLocalizedPath(locale, currentPage),
  siteOrigin
);
const idUrl = buildAbsoluteUrl(getLocalizedPath('id', currentPage), siteOrigin);
const enUrl = buildAbsoluteUrl(getLocalizedPath('en', currentPage), siteOrigin);
const ogImage = getPageOgImage(currentPage, locale, siteOrigin);
const structuredData = buildStructuredData({
  locale,
  currentPage,
  title: resolvedTitle,
  description: resolvedDescription,
  canonicalUrl,
  siteOrigin,
});
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{resolvedTitle}</title>
    <meta name="description" content={resolvedDescription} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta name="theme-color" content="#059669" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="id" href={idUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={idUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="alternate icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:site_name" content={COMPANY.legalName} />
    <meta property="og:locale" content={locale === 'id' ? 'id_ID' : 'en_US'} />
    <meta
      property="og:locale:alternate"
      content={locale === 'id' ? 'en_US' : 'id_ID'}
    />
    <meta property="og:image" content={ogImage.url} />
    <meta property="og:image:width" content={ogImage.width} />
    <meta property="og:image:height" content={ogImage.height} />
    <meta property="og:image:alt" content={ogImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedTitle} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={ogImage.url} />
    <meta name="twitter:image:alt" content={ogImage.alt} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-reveal');
      }
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-[#FAFAFA] text-neutral-900 antialiased">
    <SiteHeader client:load locale={locale} currentPage={currentPage} />
    <main class="flex-1">
      <slot />
    </main>
    <SiteFooter locale={locale} />
    <script is:inline>
      (() => {
        const targets = Array.from(document.querySelectorAll('[data-reveal]'));
        if (!targets.length) return;

        const revealVisible = () => {
          const vh = window.innerHeight || 900;
          for (const el of targets) {
            if (el.getAttribute('data-reveal') === 'visible') continue;
            const rect = el.getBoundingClientRect();
            if (rect.top <= vh + 120) {
              el.setAttribute('data-reveal', 'visible');
            }
          }
        };

        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.setAttribute('data-reveal', 'visible');
                  observer.unobserve(entry.target);
                }
              }
            },
            { threshold: 0.01, rootMargin: '120px 0px' }
          );
          for (const el of targets) observer.observe(el);
        } else {
          for (const el of targets) el.setAttribute('data-reveal', 'visible');
        }

        revealVisible();
        window.addEventListener('scroll', revealVisible, { passive: true });
      })();
    </script>
  </body>
</html>
