---
import '@fontsource-variable/geist';
import '@fontsource-variable/inter';
import '@fontsource-variable/geist-mono';
import '@/styles/global.css';
import { SiteHeader } from '@/components/layout/SiteHeader';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import { COMPANY } from '@/data/company';
import {
  getAlternateLocale,
  getAlternatePath,
  getDictionary,
  getLocalizedPath,
  type Locale,
  type PageKey,
} from '@/i18n';

interface Props {
  locale: Locale;
  currentPage: PageKey;
  title?: string;
  description?: string;
}

const { locale, currentPage, title, description } = Astro.props;
const dict = getDictionary(locale);

const resolvedTitle = title
  ? `${title} | ${dict.meta.siteTitleSuffix}`
  : dict.meta.homeTitle;
const resolvedDescription = description ?? dict.meta.homeDescription;

const currentPath = getLocalizedPath(locale, currentPage);
const alternateLocale = getAlternateLocale(locale);
const alternatePath = getAlternatePath(locale, currentPage);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="alternate icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <title>{resolvedTitle}</title>
    <meta name="description" content={resolvedDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:site_name" content={COMPANY.legalName} />
    <link rel="alternate" hreflang={locale} href={currentPath} />
    <link rel="alternate" hreflang={alternateLocale} href={alternatePath} />
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-reveal');
      }
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-[#FAFAFA] text-neutral-900 antialiased">
    <SiteHeader client:load locale={locale} currentPage={currentPage} />
    <main class="flex-1">
      <slot />
    </main>
    <SiteFooter locale={locale} />
    <script is:inline>
      (() => {
        const targets = Array.from(document.querySelectorAll('[data-reveal]'));
        if (!targets.length) return;

        const revealVisible = () => {
          const vh = window.innerHeight || 900;
          for (const el of targets) {
            if (el.getAttribute('data-reveal') === 'visible') continue;
            const rect = el.getBoundingClientRect();
            if (rect.top <= vh + 120) {
              el.setAttribute('data-reveal', 'visible');
            }
          }
        };

        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.setAttribute('data-reveal', 'visible');
                  observer.unobserve(entry.target);
                }
              }
            },
            { threshold: 0.01, rootMargin: '120px 0px' }
          );
          for (const el of targets) observer.observe(el);
        } else {
          for (const el of targets) el.setAttribute('data-reveal', 'visible');
        }

        revealVisible();
        window.addEventListener('scroll', revealVisible, { passive: true });
      })();
    </script>
  </body>
</html>
